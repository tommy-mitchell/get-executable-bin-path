{
	"name": "get-executable-bin-path",
	"version": "0.1.0",
	"description": "Get the current package's binary path and ensure it's executable.",
	"license": "MIT",
	"repository": "tommy-mitchell/get-executable-bin-path",
	"author": "Tommy Mitchell (https://tommymitchell.io)",
	"type": "module",
	"exports": {
		"types": "./dist/index.d.ts",
		"default": "./dist/index.js"
	},
	"sideEffects": false,
	"engines": {
		"node": "^22.20 || ^24.12 || >=26"
	},
	"scripts": {
		"prepare": "npm run build",
		"build": "tsc -p tsconfig.build.json && tsc -p tsconfig.dts.json",
		"lint": "xo",
		"format": "dprint fmt && xo --fix",
		"test": "c8 ava && tsc -p tsconfig.build.json && tsd -t dist/index.d.ts"
	},
	"files": [
		"dist"
	],
	"keywords": [
		"nodejs",
		"shell",
		"testing",
		"unit-testing",
		"package",
		"terminal",
		"binary",
		"bin",
		"executable",
		"package-json",
		"package.json",
		"path",
		"file",
		"fs",
		"permission"
	],
	"dependencies": {
		"get-bin-path": "^11.0.1",
		"is-executable": "^2.0.2"
	},
	"devDependencies": {
		"@tommy-mitchell/dprint-config": "^0.8.0",
		"@tommy-mitchell/eslint-config-xo": "^2.0.0-beta.7",
		"@tommy-mitchell/tsconfig": "^4.0.0",
		"@types/node": "22",
		"ava": "^8.0.1",
		"c8": "^12.0.0",
		"dprint": "^0.57.4",
		"execa": "^10.0.1",
		"tsd": "^0.33.0",
		"type-fest": "^5.10.0",
		"typescript": "~6.0.3",
		"xo": "^5.0.1"
	},
	"ava": {
		"extensions": ["ts"]
	}
}
